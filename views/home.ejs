<!DOCTYPE html>
<html lang="en">
  <head>
   <%- include('./partials/head') %>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home page</title>
  </head>
  <body>
    <%- include('./partials/nav') %>
    <% if (locals.user) { %>
       <main class="container py-4">
      <h1 class="mb-4">Welcome to the Blog</h1>
      <section class="chat-panel" aria-labelledby="chat-title">
        <div class="chat-header">
          <div>
            <h2 id="chat-title">Community chat</h2>
            <p id="chat-status" class="chat-status">Connecting...</p>
          </div>
          <span class="chat-live-dot" aria-hidden="true"></span>
        </div>
        <div id="chat-messages" class="chat-messages" aria-live="polite"></div>
        <form id="chat-form" class="chat-form" autocomplete="off">
          <label class="visually-hidden" for="chat-input">Message</label>
          <input id="chat-input" type="text" maxlength="500" placeholder="Write a message..." required />
          <button type="submit" aria-label="Send message">Send</button>
        </form>
      </section>
    </main>
    <% } %>
   
  
   <%- include('./partials/scripts') %>
   <% if (locals.user) { %>
   <script src="/socket.io/socket.io.js"></script>
   <script>
     const socket = io();
     const chatForm = document.querySelector('#chat-form');
     const chatInput = document.querySelector('#chat-input');
     const chatMessages = document.querySelector('#chat-messages');
     const chatStatus = document.querySelector('#chat-status');

     function addChatMessage(message, isSystem = false) {
       const item = document.createElement('div');
       item.className = isSystem ? 'chat-system-message' : 'chat-message';
       item.textContent = isSystem ? message : `${message.username}: ${message.text}`;
       chatMessages.appendChild(item);
       chatMessages.scrollTop = chatMessages.scrollHeight;
     }

     socket.on('connect', () => {
       chatStatus.textContent = 'You are connected';
     });

     socket.on('disconnect', () => {
       chatStatus.textContent = 'Disconnected. Reconnecting...';
     });

     socket.on('connect_error', () => {
       chatStatus.textContent = 'Sign in again to join the chat';
     });

     socket.on('chat:message', (message) => addChatMessage(message));
    socket.on('chat:history', (messages) => messages.forEach((message) => addChatMessage(message)));
     socket.on('chat:system', (message) => addChatMessage(message, true));
    socket.on('chat:error', (message) => addChatMessage(message, true));

     chatForm.addEventListener('submit', (event) => {
       event.preventDefault();
       const message = chatInput.value.trim();
       if (!message || !socket.connected) return;
       socket.emit('chat:message', message);
       chatInput.value = '';
       chatInput.focus();
     });
   </script>
   <% } %>
   <style>
     .chat-panel { max-width: 720px; margin: 0 auto; border: 1px solid #dee2e6; border-radius: 12px; overflow: hidden; background: #fff; box-shadow: 0 4px 18px rgba(0, 0, 0, .08); }
     .chat-header { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; background: #212529; color: #fff; }
     .chat-header h2 { margin: 0; font-size: 1.2rem; }
     .chat-status { margin: .25rem 0 0; color: #adb5bd; font-size: .85rem; }
     .chat-live-dot { width: 10px; height: 10px; border-radius: 50%; background: #20c997; }
     .chat-messages { height: min(55vh, 420px); min-height: 220px; overflow-y: auto; padding: 1rem; background: #f8f9fa; }
     .chat-message, .chat-system-message { overflow-wrap: anywhere; margin-bottom: .65rem; padding: .65rem .8rem; border-radius: 10px; background: #fff; }
     .chat-system-message { color: #6c757d; font-size: .85rem; font-style: italic; background: transparent; }
     .chat-form { display: flex; gap: .5rem; padding: .75rem; border-top: 1px solid #dee2e6; }
     .chat-form input { min-width: 0; flex: 1; padding: .7rem .8rem; border: 1px solid #ced4da; border-radius: 8px; }
     .chat-form button { padding: .7rem 1rem; border: 0; border-radius: 8px; color: #fff; background: #0d6efd; }
     @media (max-width: 576px) {
       .container.py-4 { padding-top: 1.25rem !important; }
       .chat-panel { border-radius: 8px; }
       .chat-messages { height: 52vh; min-height: 240px; }
       .chat-form button { min-width: 76px; }
     }
   </style>
   
  </body>
</html>
